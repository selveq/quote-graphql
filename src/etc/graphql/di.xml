<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Quote\Model\Cart\BuyRequest\BuyRequestBuilder">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="grouped" xsi:type="object">
                    ScandiPWA\QuoteGraphQl\Model\Cart\BuyRequest\GroupedDataProvider
                </item>
            </argument>
        </arguments>
    </type>

    <!-- graphql only: core's validator reads $_FILES, and on this path the file arrives as base64 JSON -->
    <type name="Magento\Catalog\Model\Product\Option\Type\File">
        <arguments>
            <argument name="validatorFile" xsi:type="object">
                ScandiPWA\QuoteGraphQl\Model\Product\Option\Type\File\ValidatorFile\Proxy
            </argument>
        </arguments>
    </type>
</config>
